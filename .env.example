# PostgreSQL (docker-compose local)
POSTGRES_USER=letterbattle
POSTGRES_PASSWORD=change-me
POSTGRES_DB=letterbattle
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# API
API_PORT=8010

# Prod backend : voir backend/.env.production.example


# Boutique de pièces (voir docs/BOUTIQUE.md). Laisser vide tant que les stores ne sont pas configurés.
GOOGLE_SERVICE_ACCOUNT_FILE=
APPLE_ISSUER_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_FILE=
APPLE_ENVIRONMENT=sandbox

# Vocal fin de partie (Agora console → Project → App ID + Primary Certificate).
# Laisser vide pour désactiver le salon vocal.
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

# --- Revenus en plus des pièces (true = activé, false = coupé) ---------------------------------
# Pubs récompensées : une vidéo regardée = REWARDED_AD_COINS pièces, REWARDED_ADS_PER_DAY fois par jour.
FEATURE_REWARDED_ADS=false
REWARDED_AD_COINS=5
REWARDED_ADS_PER_DAY=10
# Tests en local uniquement (true) ; en prod laisser false : AdMob prévient le serveur lui-même.
REWARDED_ADS_TRUST_CLIENT=false
# Pub plein écran entre les parties, toutes les INTERSTITIAL_EVERY_GAMES parties.
FEATURE_INTERSTITIAL_ADS=false
INTERSTITIAL_EVERY_GAMES=3
# Achat unique « Sans pub » (produit remove_ads dans les stores).
FEATURE_REMOVE_ADS=false
# Abonnement « Pass » (produit pass_monthly) : sans pub, bonus quotidien, jokers en plus.
FEATURE_SUBSCRIPTION=false
PASS_DAILY_COINS=20
PASS_BONUS_HINTS=2
