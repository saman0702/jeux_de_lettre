# PostgreSQL (docker-compose local)
POSTGRES_USER=letterbattle
POSTGRES_PASSWORD=change-me
POSTGRES_DB=letterbattle
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# API
API_PORT=8010

# Prod backend : voir backend/.env.production.example


# Boutique de pièces (voir docs/BOUTIQUE.md). Laisser vide tant que les stores ne sont pas configurés.
GOOGLE_SERVICE_ACCOUNT_FILE=
APPLE_ISSUER_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_FILE=
APPLE_ENVIRONMENT=sandbox
