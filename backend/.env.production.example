# Copier vers .env.production et renseigner les secrets
#   cp .env.production.example .env.production
#
# Dokploy (Docker Compose, contexte = backend/) :
#   DATABASE_URL = URL Postgres réelle (mot de passe exact du panneau DB)
#   REDIS_URL    = redis://redis:6379/0   ← hostname du service compose "redis"

DATABASE_URL=postgresql://USER:PASSWORD@HOST:5433/game-db
REDIS_URL=redis://redis:6379/0
MEDIA_DIR=media

GOOGLE_SERVICE_ACCOUNT_FILE=
APPLE_ISSUER_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_FILE=
APPLE_ENVIRONMENT=production
