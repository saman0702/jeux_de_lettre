# Copier vers .env.production (Dokploy / serveur) — ne pas committer les secrets.

DATABASE_URL=postgresql+asyncpg://USER:PASS@HOST:5432/letterbattle
REDIS_URL=redis://HOST:6379/0

# CORS / URL publique de l'API
# PUBLIC_BASE_URL=https://gamelr-api.optisoftw.com

AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

# Compte de service Google Play (vérif achats + abonnements)
GOOGLE_SERVICE_ACCOUNT_FILE=secrets/google-service-account.json

# --- Revenus : pubs + Premium en même temps ---------------------------------
# Pas de vidéos boutique (pièces) : pubs interstitielles + abo anti-pub.
FEATURE_REWARDED_ADS=false
REWARDED_AD_COINS=5
REWARDED_ADS_PER_DAY=10
REWARDED_ADS_TRUST_CLIENT=false

FEATURE_INTERSTITIAL_ADS=true
INTERSTITIAL_EVERY_GAMES=3

FEATURE_REMOVE_ADS=false
FEATURE_SUBSCRIPTION=true
PASS_DAILY_COINS=0
PASS_BONUS_HINTS=0
